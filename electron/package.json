{
  "name": "anasheed",
  "productName": "Anasheed",
  "version": "1.0.0",
  "description": "أنشودتي — مكتبة أناشيد للأطفال بصوتهم",
  "author": "Feras",
  "main": "main.js",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.feras.anasheed",
    "productName": "Anasheed",
    "files": ["main.js", "app/**/*", "build/icon.ico"],
    "directories": { "output": "out" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "أنشودتي",
      "artifactName": "Anasheed-Setup-${version}.exe"
    },
    "portable": { "artifactName": "Anasheed-Portable-${version}.exe" }
  }
}
